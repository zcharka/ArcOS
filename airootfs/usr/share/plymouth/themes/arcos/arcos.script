# ArcOS Plymouth Theme

Window.SetBackgroundTopColor(0.10, 0.04, 0.18);
Window.SetBackgroundBottomColor(0.03, 0.01, 0.07);

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);

logo_sprite.SetX(
    Window.GetWidth() / 2 -
    logo_image.GetWidth() / 2
);

logo_sprite.SetY(
    Window.GetHeight() / 2 -
    logo_image.GetHeight() / 2
);
